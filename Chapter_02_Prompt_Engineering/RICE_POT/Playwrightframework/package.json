{
  "name": "vwo-login-playwright-framework",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright Cucumber framework for the VWO login dashboard",
  "scripts": {
    "test": "cucumber-js",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:invalid": "cross-env HEADLESS=false cucumber-js features/login.feature --tags @invalid",
    "test:valid": "cross-env HEADLESS=false cucumber-js features/login.feature --tags @valid",
    "report:allure": "allure generate allure-results --clean -o allure-report"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "allure-cucumberjs": "^3.4.0",
    "allure-commandline": "^2.34.1",
    "cross-env": "^10.1.0",
    "playwright": "^1.64.1"
  }
}
